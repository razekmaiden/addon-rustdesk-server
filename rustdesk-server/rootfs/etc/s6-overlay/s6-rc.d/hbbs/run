#!/command/with-contenv bashio
# shellcheck shell=bash
# ==============================================================================
# Home Assistant Add-on: RustDesk-Server
# Ejecuta hbbs (servidor de señalización)
# ==============================================================================

# Verificar si la variable de entorno RELAY está definida
if bashio::config.exists 'relay'; then
    RELAY=$(bashio::config 'relay')
    bashio::log.info "Relay para hbbs configurado en $RELAY"
fi


sleep 10
cd /config
PARAMS=
[ "${ENCRYPTED_ONLY}" = "1" ] && PARAMS="-k _"


bashio::log.info $(/opt/rustdesk-server/hbbs --version)
/opt/rustdesk-server/hbbs ${RELAY:+-r "$RELAY"} $PARAMS
